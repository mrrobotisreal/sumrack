{
  "name": "@sumrak/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas + TS types for content packs, manifest, and backup envelope — the single source of truth shared by the app and the authoring pipeline",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:fixtures": "node scripts/gen-fixtures.mjs"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
